# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# Hostinger FTP Accounts panel → demo.toolsandtable.com → Files → FTP Accounts
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Plain FTP (matches the ftp:// scheme Hostinger shows). Set to "true" if the
# server requires explicit FTPS and plain FTP connections are refused.
FTP_SECURE=false
# WordPress document root on the remote account, relative to the FTP login
# directory. Leave empty if the FTP account's home directory already IS the
# document root (e.g. this is the case for demo.toolsandtable.com — verify
# with an FTP directory listing before assuming "public_html" is needed here,
# since that's a common wrong guess that creates a nested public_html/public_html).
FTP_REMOTE_ROOT=

# WordPress REST API (Application Password) — for changes FTP can't make
# (anything stored in the DB: site icon, options, media library, etc).
# Generate via wp-admin → Users → Profile → Application Passwords.
WP_API_BASE_URL=
WP_API_USER=
WP_API_APP_PASSWORD=
